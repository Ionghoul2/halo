    "note": "Planned. Strip lengths, mounts, controller and power not verified. Separate controller from body lights unless tested otherwise.",
    "standalonePrice": null
  },
  "products": {
    "static": {
      "name": "Static Classic",
      "slug": "static-classic",
      "status": "early-access",
      "tagline": "The iconic lit-up car.",
      "summary": "Thousands of small fixed-color lights across the panels you choose. The classic holiday look.",
      "planned": [
        "Fixed-color illumination",
        "Warm white or multicolor (depends on sourced strands)",
        "Built for parked displays, photos and events"
      ],
      "notPromised": [
        "Color changing",
        "App control",
        "Custom graphics or animations"
      ],
      "media": "classic-string-lambos"
