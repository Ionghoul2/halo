{
  "brand": "Car Glow",
  "currency": "USD",
  "version": "2026-11-13",
  "notice": "All prices are owner target prices. LED counts are planning estimates from the ChatGPT area model. Nothing is purchasable until supplier-verified.",
  "measurementModel": {
    "formula": "LEDs = covered sq ft x 144 / pitch_in^2 x 1.15, rounded up",
    "pitchIn": {
      "static": 2,
      "rgb": 2,
      "mapping": 1.5
    },
    "sqFt": {
      "S": 105,
      "M": 135,
      "L": 195
    },
    "note": "Square-grid fill of an assumed covered area plus 15% routing and spares. Not a measured vehicle."
  },
  "sizes": {
    "S": {
      "name": "Small",
      "lengthFt": "13-15",
      "examples": "Compact, small coupe, most 2-door sports cars",
      "maxSqFt": 105
    },
    "M": {
      "name": "Medium",
      "lengthFt": "over 15-17",
      "examples": "Sedan, crossover",
      "maxSqFt": 135
    },
    "L": {
      "name": "Large",
      "lengthFt": "over 17-20",
      "examples": "Full-size SUV, pickup",
      "maxSqFt": 195
    },
    "CUSTOM": {
      "name": "Custom",
      "lengthFt": "over 20 or unusual shape",
      "examples": "Extended truck, van, oversize",
      "note": "Fitment check required"
    }
  },
  "underglow": {
    "S": {
      "name": "Standard 4-piece RGBIC",
      "upcharge": 45
    },
    "M": {
      "name": "Standard 4-piece RGBIC",
      "upcharge": 45
    },
    "L": {
      "name": "Extended 6-piece XL RGBIC",
      "upcharge": 58
