    "rgb": {
      "name": "Color-Changing RGB",
      "slug": "color-changing-rgb",
      "status": "early-access",
      "tagline": "Pick the color. Change it again.",
      "summary": "The same full-body look with lights you can switch between colors and preset effects.",
      "planned": [
        "Selectable colors",
        "Preset effects and smooth transitions",
        "Remote or app control (depends on controller)"
      ],
      "notPromised": [
        "Pixel-level chasing (needs addressable strands)",
        "Custom uploaded graphics",
        "Sync with underglow"
      ],
      "media": "dense-red"
    },
    "mapping": {
      "name": "Graphic Mapping",
      "slug": "graphic-mapping",
      "status": "concept",
      "tagline": "Your car becomes the screen.",
      "summary": "A dense grid of individually controlled pixels that can show designs, holiday graphics and coordinated animation.",
